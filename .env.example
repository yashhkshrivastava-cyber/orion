# Copy to .env and adjust before running: cp .env.example .env

# Database
# Local Homebrew Postgres: ORION_DB_HOST=localhost
# Shared Tailscale Postgres: ORION_DB_HOST=100.71.92.51
# Password must be orion_dev_password. On first connect the app rotates the
# older StrongPassword123 role password if that is still set on the server.
ORION_DB_HOST=localhost
ORION_DB_PORT=5432
ORION_DB_NAME=orion
ORION_DB_USER=orion_user
ORION_DB_PASSWORD=orion_dev_password

# Auth — change these before exposing on your tailnet
ORION_SESSION_SECRET=change-me-to-a-long-random-string
ORION_ADMIN_USERNAME=admin
ORION_ADMIN_PASSWORD=change-me-admin-password
ORION_SESSION_TTL_DAYS=7

# Streamlit
ORION_PORT=8501
ORION_BIND=0.0.0.0
