# Copy to .env and adjust before running: cp .env.example .env

# Database — local Postgres role created by init_db
ORION_DB_HOST=localhost
ORION_DB_PORT=5432
ORION_DB_NAME=orion
ORION_DB_USER=orion_app
ORION_DB_PASSWORD=orion_dev_password

# Streamlit login (created on first launch if no users exist)
ORION_SESSION_SECRET=change-me-to-a-long-random-string
ORION_ADMIN_USERNAME=orion
ORION_ADMIN_PASSWORD=orion_dev_password
ORION_SESSION_TTL_DAYS=7

# Streamlit
ORION_PORT=8501
ORION_BIND=0.0.0.0
