{
  "name": "Orion Streamlit + PostgreSQL",
  "user": "ubuntu",
  "install": "bash .cursor/install.sh",
  "start": "bash .cursor/start.sh",
  "terminals": [
    {
      "name": "streamlit",
      "command": "./.venv/bin/streamlit run app.py --server.port 8501 --server.address 0.0.0.0 --server.headless true"
    }
  ],
  "ports": [
    { "name": "streamlit", "port": 8501 }
  ]
}
