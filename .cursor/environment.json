{
  "name": "Orion Platform",
  "user": "ubuntu",
  "install": "bash .cursor/install.sh",
  "start": "bash .cursor/start.sh",
  "ports": [
    {
      "name": "streamlit",
      "port": 8501
    }
  ],
  "terminals": [
    {
      "name": "streamlit",
      "command": "set -a && [ -f .cursor/runtime.env ] && . .cursor/runtime.env; set +a && ./.venv/bin/streamlit run app.py --server.port 8501 --server.address 0.0.0.0 --server.headless true",
      "description": "Orion Streamlit web app"
    }
  ]
}
